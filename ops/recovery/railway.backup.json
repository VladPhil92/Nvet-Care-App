{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "/ops/recovery/Dockerfile",
    "watchPatterns": [
      "/ops/recovery/**"
    ]
  },
  "deploy": {
    "startCommand": "python3 /opt/nvet-recovery/backup.py",
    "restartPolicyType": "NEVER"
  }
}
