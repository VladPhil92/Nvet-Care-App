# Nvet Care canonical Railway image
#
# Build context: repository root.
# Runtime source of truth: backend/ workspace.
# The temporary nvet-backend compatibility bridge is intentionally not used.

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Keep the root lockfile authoritative while installing only the backend
# workspace (plus root metadata). Copy package manifests first for layer cache.
COPY package.json package-lock.json ./
COPY backend/package.json ./backend/package.json
COPY mobile/package.json ./mobile/package.json
COPY dashboard/package.json ./dashboard/package.json

RUN npm ci \
  --workspace backend \
  --include-workspace-root \
  --include=dev \
  --legacy-peer-deps \
  --no-audit \
  --no-fund

COPY backend ./backend

# Prisma generate only needs a syntactically valid URL at image-build time;
# production DATABASE_URL is injected by Railway at predeploy/runtime.
RUN cd backend \
  && DATABASE_URL='postgresql://stub:stub@localhost:5432/stub?schema=public' npx prisma generate \
  && npm run build

ENV NODE_ENV=production
WORKDIR /app

CMD ["node", "backend/scripts/railway-runtime-smoke.mjs"]
