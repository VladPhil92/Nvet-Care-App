{
  "name": "NvetCare",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest --testPathIgnorePatterns=/e2e/",
    "test:ci": "jest --testPathIgnorePatterns=/e2e/ --ci --coverage --maxWorkers=2",
    "test:watch": "jest --testPathIgnorePatterns=/e2e/ --watch",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "build:android": "cd android && ./gradlew bundleRelease",
    "e2e:build:ios": "detox build -c ios.sim.debug",
    "e2e:test:ios": "detox test -c ios.sim.debug",
    "e2e:build:android": "detox build -c android.emu.debug",
    "e2e:test:android": "detox test -c android.emu.debug"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-native-community/datetimepicker": "^8.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@sentry/react-native": "^8.27.0",
    "@tanstack/query-async-storage-persister": "^5.59.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.59.0",
    "axios": "^1.7.7",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-maps": "1.18.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^3.34.0",
    "react-native-svg": "^15.6.0",
    "react-native-vector-icons": "^10.2.0",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.0",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.16.11",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-plugin-module-resolver": "^5.0.2",
    "detox": "20.27.6",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-circus": "^29.7.0",
    "msw": "^2.4.9",
    "prettier": "^3.3.0",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.3",
    "undici": "^6.20.1",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/jest-preset": "0.87.1",
    "@types/react-test-renderer": "^19.1.0",
    "react-test-renderer": "19.2.3"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
