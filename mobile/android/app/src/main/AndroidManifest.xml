<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          Android 16/API 36 stabilization boundary.
          The current React Native/React Navigation stack still owns back navigation through
          the legacy callback path, so predictive back is explicitly opted out until the
          navigation stack is migrated and device-tested. This avoids API 36 silently ignoring
          onBackPressed/KEYCODE_BACK while preserving deterministic navigation for 1.0.
        -->

        <!--
          Nvet 1.0 is phone-first and has not yet completed physical tablet/foldable UX
          certification. Android 16 ignores portrait/resizability restrictions on >=600dp by
          default; keep compatibility mode explicit until that separate adaptive-layout test
          matrix is completed. Phone behavior is unchanged.
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${GOOGLE_MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- React Navigation custom-scheme deep links, e.g. nvetcare://chat/:appointmentId. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nvetcare" />
            </intent-filter>
        </activity>
    </application>
</manifest>
