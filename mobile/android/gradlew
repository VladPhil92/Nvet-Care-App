#!/bin/sh
set -eu
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
WRAPPER_JAR="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
  echo "Gradle wrapper JAR is missing: $WRAPPER_JAR" >&2
  echo "Restore it from the React Native 0.87 upstream wrapper (Gradle 9.4.1) before building." >&2
  exit 1
fi
exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" -Dorg.gradle.appname=gradlew -jar "$WRAPPER_JAR" "$@"
