// Prisma Schema for Nvet Care Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  VET
  CLIENT
}

enum VetTier {
  FREE
  PRO
  ELITE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  CTG
  PSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  VERIFYING
  CONFIRMED
  LIQUIDATED
  DISPUTED
  FAILED
}

enum MessageType {
  TEXT
  PRICE_OFFER
  SYSTEM
}

// ============================================
// MODELS
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(CLIENT)
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  phone         String?
  avatar        String?
  
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  
  // Relations
  vetProfile    VetProfile?
  pets          Pet[]
  appointments  Appointment[] @relation("ClientAppointments")
  messages      Message[]
  reviews       Review[]

  @@map("users")
}

model VetProfile {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  licenseNumber   String    @unique @map("license_number")
  specialties     String[]
  tier            VetTier   @default(FREE)
  ctgBalance      Float     @default(0) @map("ctg_balance")
  
  bio             String?
  yearsExperience Int?      @map("years_experience")
  rating          Float?    @default(0)
  reviewCount     Int       @default(0) @map("review_count")
  
  isVerified      Boolean   @default(false) @map("is_verified")
  isActive        Boolean   @default(true) @map("is_active")
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  appointments    Appointment[] @relation("VetAppointments")
  prices          Price[]
  reviews         Review[]

  @@map("vet_profiles")
}

model Pet {
  id          String    @id @default(uuid())
  ownerId     String    @map("owner_id")
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  name        String
  species     String
  breed       String?
  weight      Float?
  birthDate   DateTime? @map("birth_date")
  
  photo       String?
  notes       String?
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  // Relations
  appointments Appointment[]

  @@map("pets")
}

model Appointment {
  id              String              @id @default(uuid())
  
  vetId           String              @map("vet_id")
  vet             VetProfile          @relation("VetAppointments", fields: [vetId], references: [id])
  
  clientId        String              @map("client_id")
  client          User                @relation("ClientAppointments", fields: [clientId], references: [id])
  
  petId           String              @map("pet_id")
  pet             Pet                 @relation(fields: [petId], references: [id])
  
  serviceType     String              @map("service_type")
  date            DateTime
  time            String
  address         String
  
  status          AppointmentStatus   @default(PENDING)
  paymentMethod   PaymentMethod       @map("payment_method")
  amount          Float
  
  notes           String?
  diagnosis       String?
  treatment       String?
  
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  
  // Relations
  transaction     Transaction?
  messages        Message[]
  review          Review?

  @@index([vetId])
  @@index([clientId])
  @@index([date])
  @@map("appointments")
}

model Transaction {
  id                String              @id @default(uuid())
  
  appointmentId     String              @unique @map("appointment_id")
  appointment       Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  amountCop         Float               @map("amount_cop")
  amountCtg         Float?              @map("amount_ctg")
  
  commissionPct     Float               @map("commission_pct")
  commissionAmount  Float               @map("commission_amount")
  
  paymentMethod     PaymentMethod       @map("payment_method")
  status            TransactionStatus   @default(PENDING)
  
  hashOnchain       String?             @map("hash_onchain")
  transferCode      String?             @map("transfer_code")
  
  verifiedAt        DateTime?           @map("verified_at")
  liquidatedAt      DateTime?           @map("liquidated_at")
  
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([status])
  @@index([paymentMethod])
  @@map("transactions")
}

model Price {
  id          String    @id @default(uuid())
  
  vetId       String    @map("vet_id")
  vet         VetProfile @relation(fields: [vetId], references: [id], onDelete: Cascade)
  
  serviceName String    @map("service_name")
  priceCop    Float     @map("price_cop")
  priceCtg    Float     @map("price_ctg")
  
  isActive    Boolean   @default(true) @map("is_active")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([vetId, serviceName])
  @@map("prices")
}

model Message {
  id              String      @id @default(uuid())
  
  appointmentId   String      @map("appointment_id")
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  senderId        String      @map("sender_id")
  sender          User        @relation(fields: [senderId], references: [id])
  
  content         String
  type            MessageType @default(TEXT)
  
  priceData       Json?       @map("price_data")
  
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([appointmentId])
  @@map("messages")
}

model Review {
  id              String      @id @default(uuid())
  
  appointmentId   String      @unique @map("appointment_id")
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  vetId           String      @map("vet_id")
  vet             VetProfile  @relation(fields: [vetId], references: [id])
  
  clientId        String      @map("client_id")
  client          User        @relation(fields: [clientId], references: [id])
  
  rating          Int
  comment         String?
  
  createdAt       DateTime    @default(now()) @map("created_at")

  @@index([vetId])
  @@map("reviews")
}
