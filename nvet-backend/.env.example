# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://nvet_user:nvet_password_dev@localhost:5432/nvet_db?schema=public"

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ============================================
# REDIS
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# EMAIL SERVICE (Resend / SendGrid)
# ============================================
EMAIL_API_KEY="your-email-api-key"
EMAIL_FROM="noreply@nvetcare.com"

# ============================================
# BLOCKCHAIN (Polygon)
# ============================================
CTG_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/YOUR-API-KEY"
CTG_CONTRACT_ADDRESS="0x..." 
CTG_PRIVATE_KEY="your-private-key-for-transactions"
CTG_PRICE_COP=420

# ============================================
# PAYMENT GATEWAYS
# ============================================
PSE_API_KEY="your-pse-gateway-api-key"
PSE_API_URL="https://api.pse-gateway.com/v1"

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV="development"
PORT=3000
API_PREFIX="api"

# ============================================
# CORS
# ============================================
CORS_ORIGIN="http://localhost:3001"

# ============================================
# FILE UPLOADS (S3 / Cloudinary)
# ============================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================
# RATE LIMITING
# ============================================
THROTTLE_TTL=60
THROTTLE_LIMIT=10
