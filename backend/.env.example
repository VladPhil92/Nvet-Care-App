# Nvet Care Backend — environment example
# Copy to .env for local development. Never commit real credentials.

NODE_ENV="development"
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nvetcare?schema=public"

# ============================================
# AUTH / JWT
# ============================================
JWT_SECRET="replace-with-at-least-64-random-chars"
JWT_REFRESH_SECRET="replace-with-a-different-at-least-64-random-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
TWO_FACTOR_ENCRYPTION_KEY="replace-with-32-byte-key-material"

# Canonical CTG One identity bridge
NVET_CTG_IDENTITY_EXCHANGE_ENABLED="true"
NVET_CTG_IDENTITY_EXCHANGE_DISABLED="false"
NVET_CTG_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NVET_CTG_SUPABASE_AUDIENCE="authenticated"
NVET_CTG_SUPERADMIN_EMAIL=""

# ============================================
# MAIL
# ============================================
MAIL_DRIVER="console" # console | sendgrid | ses | smtp
MAIL_FROM="Nvet Care <no-reply@example.com>"
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""

# ============================================
# REDIS / RESILIENCE
# ============================================
REDIS_URL="redis://localhost:6379"

# ============================================
# FRONTEND / CORS
# ============================================
FRONTEND_URL="http://localhost:5173"
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"   # comma-separated

# ============================================
# RATE LIMITING (defaults; pueden sobreescribirse por endpoint con @Throttle)
# ============================================
THROTTLE_TTL=60          # segundos
THROTTLE_LIMIT=200       # requests por TTL

# ============================================
# BLOCKCHAIN (Polygon — CTG token)
# ============================================
CTG_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/YOUR-API-KEY"
CTG_CONTRACT_ADDRESS="0x..."
CTG_PRIVATE_KEY=""                  # Solo para wallet operacional, NO la treasury
CTG_PRICE_COP=420

# ============================================
# PAYMENT GATEWAYS (PSE)
# ============================================
PSE_API_KEY=""
PSE_API_URL="https://api.pse-gateway.com/v1"
PSE_WEBHOOK_SECRET=""               # HMAC del provider para validar webhooks

# ============================================
# FILE UPLOADS (verification docs, transfer comprobantes)
# ============================================
# Sensitive production uploads are fail-closed unless private Cloudinary
# storage is configured. If STORAGE_DRIVER is omitted and all three Cloudinary
# credentials exist, the backend auto-selects Cloudinary for backward-compatible
# production convergence.
STORAGE_DRIVER="local"               # local (dev/test) | cloudinary (production)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="nvetcare"
UPLOAD_DIR=""

# Server-side upload hard limit is 10 MB and content is verified by magic bytes.
UPLOAD_MAX_VERIFICATION_MB=10
UPLOAD_MAX_TRANSFER_MB=5

# ============================================
# AI CARE COPILOT (CLIENT + VET)
# ============================================
# Si OPENAI_API_KEY está vacío, la IA generativa falla cerrado con 503.
# La capa determinística de emergencia del endpoint CLIENT se ejecuta antes
# del proveedor para no depender de latencia o disponibilidad del modelo.
AI_ASSIST_ENABLED="true"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_ASSIST_TIMEOUT_MS=15000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL="info"                    # trace | debug | info | warn | error
LOG_PRETTY="true"                   # pretty-print en dev; false en prod (JSON)
