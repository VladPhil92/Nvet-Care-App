# ============================================================
# Nvet Care Backend · .env.example
# ============================================================
# Genera secrets seguros con:
#   node scripts/generate-secrets.mjs > .env.secrets
# Y carga las variables en .env (NO commitear .env real).
# ============================================================

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV="development"        # development | staging | production
PORT=3000
API_PREFIX="api"
FRONTEND_URL="http://localhost:5173"   # Usado en links de email

# ============================================
# DATABASE (PostgreSQL 14+)
# ============================================
# Producción: usar TLS (?sslmode=require) y connection_limit específico
DATABASE_URL="postgresql://nvet_user:nvet_password_dev@localhost:5432/nvet_db?schema=public&connection_limit=10&pool_timeout=10"

# ============================================
# JWT AUTHENTICATION (CRÍTICO — generar con generate-secrets.mjs)
# ============================================
# 32 bytes hex (64 chars) cada uno. NUNCA reutilizar entre access/refresh.
JWT_SECRET="REPLACE_ME_64_HEX_CHARS_FROM_GENERATE_SECRETS"
JWT_REFRESH_SECRET="REPLACE_ME_DIFFERENT_64_HEX_CHARS"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_DAYS=7

# ============================================
# CTG ONE IDENTITY EXCHANGE (docs/identity/ADR-001, repo ctg_one_website)
# ============================================
# Fase 4 ya está lanzada. Si la variable no existe, el runtime habilita el
# exchange por defecto. Configurar explícitamente "false" funciona como
# kill switch de emergencia y hace que POST /auth/ctg-identity-exchange
# responda 404 sin debilitar el resto de la autenticación.
NVET_CTG_IDENTITY_EXCHANGE_ENABLED="true"
# URL pública del proyecto Supabase canónico de CTG One. El runtime usa
# esta misma URL como fallback si la variable no fue provisionada; se puede
# sobreescribir para staging. Se usa para JWKS e issuer validation y NO es
# una credencial ni una key secreta.
NVET_CTG_SUPABASE_URL="https://mdscwjvlihdiflcvghhk.supabase.co"
# Audience esperada en el JWT de Supabase. "authenticated" es el valor
# estándar de Supabase Auth para sesiones de usuario -- no cambiar salvo
# que el proyecto Supabase use un audience custom.
NVET_CTG_SUPABASE_JWT_AUDIENCE="authenticated"

# ============================================
# PHASE 12 · CLOSED BETA CARTAGENA
# ============================================
# Interruptor operacional independiente del control de cohorte. Configurar
# false detiene NUEVAS reservas pero conserva login, sesiones, historial y soporte.
NVET_BOOKING_ENABLED="true"
# OFF por defecto. Al activarlo, el backend restringe NUEVAS reservas a clientes
# invitados mediante el Admin Cohort Control Plane y a veterinarios cuyo
# VetProfile.city sea Cartagena. Login, recuperación y datos existentes siguen activos.
NVET_CLOSED_BETA_ENABLED="false"
NVET_CLOSED_BETA_MARKET="Cartagena de Indias"
# La cohorte canónica se administra desde Dashboard → Cohorte Beta y se deriva
# de eventos append-only en audit_logs. NVET_CLOSED_BETA_CLIENT_HASHES está
# deprecada y el runtime canónico de Phase 12F no la consume.
# Owner/rol operacional y ruta oficial de soporte para la cohorte. Estos
# valores se configuran en el proveedor y NO deben contener tokens/secrets.
# GET /api/beta/readiness solo expone si están configurados, no su contenido.
NVET_BETA_SUPPORT_OWNER=""
NVET_BETA_SUPPORT_CHANNEL=""

# ============================================
# 2FA (TOTP encryption — AES-256-GCM)
# ============================================
# 32 bytes hex. ROTAR esta key implica re-cifrar twoFactorSecret de TODOS
# los usuarios con 2FA activo (proceso planeado, no automatizado).
TWO_FACTOR_ENCRYPTION_KEY="REPLACE_ME_64_HEX_CHARS"

# Salt opcional para hashes de sessionId (defensa en profundidad)
SESSION_ID_SALT="REPLACE_ME_32_HEX_CHARS"

# ============================================
# REDIS (cache, blacklist, idempotency stores)
# ============================================
# Si está vacío, los servicios usan in-memory KvStore (no apto para multi-instance)
REDIS_URL="redis://localhost:6379"
# REDIS_TLS="true"           # activar para Upstash/AWS ElastiCache
# REDIS_PASSWORD=""

# ============================================
# EMAIL (driver pluggable: console | sendgrid | ses | smtp)
# ============================================
MAIL_DRIVER="console"               # dev usa console; staging/prod usar sendgrid
MAIL_FROM="no-reply@nvetcare.co"
MAIL_FROM_NAME="Nvet Care"

# --- SendGrid (MAIL_DRIVER=sendgrid) ---
SENDGRID_API_KEY=""                 # SG.xxxxx... — sandbox tier 100/día gratis

# --- AWS SES (MAIL_DRIVER=ses) — stub, requiere npm install @aws-sdk/client-ses ---
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# --- SMTP genérico (MAIL_DRIVER=smtp) — stub, requiere npm install nodemailer ---
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE="false"               # true para puerto 465
# SMTP_USER=""
# SMTP_PASS=""

# ============================================
# OBSERVABILITY (Sentry)
# ============================================
# Si vacío, Sentry no se inicializa (zero overhead en dev)
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"     # 10% en prod, 1.0 en dev
SENTRY_ENVIRONMENT="development"    # development | staging | production

# ============================================
# CORS
# ============================================
CORS_ORIGIN="http://localhost:5173,http://localhost:3001"   # comma-separated

# ============================================
# RATE LIMITING (defaults; pueden sobreescribirse por endpoint con @Throttle)
# ============================================
THROTTLE_TTL=60          # segundos
THROTTLE_LIMIT=200       # requests por TTL

# ============================================
# BLOCKCHAIN (Polygon — CTG token)
# ============================================
CTG_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/YOUR-API-KEY"
CTG_CONTRACT_ADDRESS="0x..."
CTG_PRIVATE_KEY=""                  # Solo para wallet operacional, NO la treasury
CTG_PRICE_COP=420

# ============================================
# PAYMENT GATEWAYS (PSE)
# ============================================
PSE_API_KEY=""
PSE_API_URL="https://api.pse-gateway.com/v1"
PSE_WEBHOOK_SECRET=""               # HMAC del provider para validar webhooks

# ============================================
# FILE UPLOADS (verification docs, transfer comprobantes)
# ============================================
# En desarrollo puede usarse almacenamiento local. En producción, los dominios
# sensibles `verification/*` y `transfers/*` fallan cerrado si no existe storage
# privado. Cloudinary se selecciona al definir STORAGE_DRIVER=cloudinary o, por
# compatibilidad con despliegues legacy, automáticamente cuando las tres
# credenciales CLOUDINARY_* están presentes.
STORAGE_DRIVER="local"               # local (dev/test) | cloudinary (producción)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="nvetcare"
UPLOAD_DIR=""

# Tamaños máximos (en MB). El backend además aplica límite duro de 10 MB y
# valida magic bytes para JPEG/PNG/PDF antes de persistir.
UPLOAD_MAX_VERIFICATION_MB=10
UPLOAD_MAX_TRANSFER_MB=5

# ============================================
# AI CARE COPILOT (CLIENT + VET)
# ============================================
# Si OPENAI_API_KEY está vacío, la IA generativa falla cerrado con 503.
# La capa determinística de emergencia del endpoint CLIENT se ejecuta antes
# del proveedor para no depender de latencia o disponibilidad del modelo.
AI_ASSIST_ENABLED="true"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
OPENAI_BASE_URL="https://api.openai.com/v1"
AI_ASSIST_TIMEOUT_MS=15000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL="info"                    # trace | debug | info | warn | error
LOG_PRETTY="true"                   # pretty-print en dev; false en prod (JSON)
