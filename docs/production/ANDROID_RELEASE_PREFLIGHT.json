{
  "schemaVersion": 1,
  "phase": "13E",
  "program": "android-google-play-release-preflight",
  "applicationId": "com.nvetcare",
  "targetSdk": 36,
  "compileSdk": 36,
  "releaseArtifact": "aab",
  "releaseWorkflow": ".github/workflows/release-android.yml",
  "technicalGates": {
    "packageIdentityPinned": "verified",
    "apiLevelPinned": "verified",
    "releaseSigningFailClosed": "verified",
    "uploadCertificatePinning": "verified",
    "immutableTagBuild": "verified",
    "aabSignatureVerification": "verified",
    "artifactChecksums": "verified",
    "draftOnlyInternalUpload": "verified",
    "automaticProductionPromotionDisabled": "verified",
    "privacyPolicySourcePrepared": "verified",
    "dataSafetySourcePrepared": "verified",
    "reviewerAccessRunbookPrepared": "verified",
    "accountDeletionContractPrepared": "verified",
    "android16CompatibilityPrepared": "verified"
  },
  "operatorHandoff": [
    {
      "id": "legal-controller-identity",
      "status": "operator-required",
      "owner": "legal-product-operator",
      "reason": "The final privacy controller identity must match the actually constituted production entity."
    },
    {
      "id": "play-console-app",
      "status": "operator-required",
      "owner": "play-operator",
      "reason": "Google Play Console must contain the com.nvetcare application in the intended developer account."
    },
    {
      "id": "play-app-signing",
      "status": "operator-required",
      "owner": "play-operator",
      "reason": "Play App Signing is external provider configuration."
    },
    {
      "id": "release-secrets",
      "status": "operator-required",
      "owner": "release-operator",
      "reason": "Keystore, upload certificate fingerprint, Maps key and Play service-account credential must be provisioned through protected GitHub environment secrets."
    },
    {
      "id": "privacy-policy-publication",
      "status": "operator-required",
      "owner": "legal-product-operator",
      "reason": "A public HTTPS policy URL, effective date, monitored contact and final controller identity remain external evidence."
    },
    {
      "id": "data-safety-play-review",
      "status": "operator-required",
      "owner": "play-product-operator",
      "reason": "The final Play Console declaration must be reconciled with active production processors."
    },
    {
      "id": "reviewer-access",
      "status": "operator-required",
      "owner": "play-operator",
      "reason": "Dedicated CLIENT and VET reviewer credentials must be configured outside Git."
    },
    {
      "id": "signed-aab",
      "status": "operator-required",
      "owner": "release-operator",
      "reason": "A signed bundle can only be certified after the immutable RC tag and protected signing secrets exist."
    },
    {
      "id": "internal-track-upload",
      "status": "operator-required",
      "owner": "play-operator",
      "reason": "The actual Play Internal Testing upload remains external evidence."
    },
    {
      "id": "physical-device-smoke",
      "status": "operator-required",
      "owner": "qa-operator",
      "reason": "At least two real devices remain required for final smoke evidence."
    }
  ],
  "policy": {
    "externalEvidenceNeverAutoVerified": true,
    "secretsNeverCommitted": true,
    "playAutomationMaximumStatus": "draft",
    "productionPromotionManual": true,
    "paymentRailIndependent": true
  }
}
