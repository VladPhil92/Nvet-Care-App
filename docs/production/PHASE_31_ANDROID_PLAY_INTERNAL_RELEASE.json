{
  "schemaVersion": 1,
  "phase": 31,
  "program": "android-play-internal-release",
  "candidate": "1.0.0-rc.2",
  "applicationId": "com.nvetcare",
  "targetSdk": 36,
  "prerequisitePhase": 30,
  "prerequisiteManifest": "docs/production/PHASE_30_CARTAGENA_BETA_OBSERVATION_CLOSURE.json",
