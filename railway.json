{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "/ops/recovery/Dockerfile",
        "buildCommand": null,
        "watchPatterns": [
            "/ops/recovery/**",
            "/railway.json"
        ]
    },
    "deploy": {
        "startCommand": "python3 /opt/nvet-recovery/backup.py",
        "restartPolicyType": "NEVER"
    }
}
